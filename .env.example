# Matter-Born Server Configuration Template

# Port assigned dynamically by hosting provider (Render / Railway / Heroku) or default 3000 locally
PORT=3000

# Environment mode ('development' or 'production')
NODE_ENV=production

# CORS allowed origins ('*' or specific mobile app schemes / domains)
CORS_ORIGIN=*

# Public Server URL (e.g. https://matter-born.onrender.com or https://matter-born-production.up.railway.app)
SERVER_PUBLIC_URL=https://matter-born.onrender.com

# Supabase / PostgreSQL credentials for server-side persistence (accounts, progression, weapons)
# Keep on server side only — NEVER expose service role key to mobile client!
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini API Key for server-side AI creature generation & tactical combat analysis
GEMINI_API_KEY=
